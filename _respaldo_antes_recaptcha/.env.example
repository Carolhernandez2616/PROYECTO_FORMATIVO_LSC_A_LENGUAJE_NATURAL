# Copia este archivo como .env y completa los valores. NO lo compartas ni lo subas a repositorios.
DB_HOST=localhost
DB_PORT=3306
DB_USER=tu_usuario_mysql
DB_PASSWORD="tu_contraseña_mysql"
DB_NAME=manos_que_hablan

PORT=3000
HOST=127.0.0.1

# Administrador (se crea solo si aún no existe). Contraseña de mínimo 12 caracteres.
ADMIN_EMAIL=admin@ejemplo.local
ADMIN_PASSWORD="cambia_esta_clave_por_una_propia"

# Clave para firmar sesiones: mínimo 32 caracteres aleatorios. Si falta, se usa una temporal.
SESSION_SECRET="zapatozapato2026@2026"

# Dirección pública con la que se abre la página (se usa en el enlace de recuperación)
APP_URL=http://localhost:3000

# Recuperación de contraseña por correo (opcional). Sin SMTP_HOST, el enlace se escribe en la terminal del servidor.
# SMTP_HOST=smtp.tu-proveedor.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=usuario
# SMTP_PASS="contraseña_smtp"
# SMTP_FROM="Manos que Hablan <no-responder@tu-dominio.com>"

# HTTPS opcional (necesario para cámara y micrófono desde otros dispositivos)
# TLS_KEY_FILE=C:\ruta\clave.pem
# TLS_CERT_FILE=C:\ruta\certificado.pem
